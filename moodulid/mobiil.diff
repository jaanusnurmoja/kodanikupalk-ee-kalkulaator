+}
+
+/* ==========================================================================
+   KALKULAATORI MOBIILIVAADE
+   Kitsas vaates (alla 992 px) saavad kaks veergu (lähteandmed ja kalkulaator)
+   vahelehed. Arvutivaade (alates 992 px) jääb samaks.
+   Seotud: index.php (märgend .calc-layout, .calc-tabs, .calc-pane-*),
+   js/calc-mobile.js (vahelehtede ja peitmisnuppude loogika) ja
+   kalkulaator-uus.phtml (tulemustabeli veerud).
+   Kitsa vaate piir (991.98px = Bootstrapi lg) on kirjas ainult ühes kohas:
+   allpool plokis "@media (max-width: 991.98px)". JS loeb piiri muutujast
+   --calc-narrow, seega piiri muutmisel piisab selle ühe plokiga.
+   ========================================================================== */
+
+/* JS loeb sellest, kas vaade on kitsas (0 = arvutivaade, 1 = kitsas vaade) */
+.calc-layout { --calc-narrow: 0; }
+
+/* Vahelehtede riba: arvutivaates alati peidus; kitsas vaates ilmub alles siis,
+   kui calc-mobile.js on käivitunud (.calc-js). Ilma JS-ita jäävad veerud lihtsalt üksteise alla. */
+.calc-tabs { display: none; }
+
+.calc-tab {
+  flex: 1 1 0;
+  padding: .6rem .75rem;
+  font: inherit;
+  font-weight: 600;
+  line-height: 1.2;
+  color: var(--cassiopeia-color-link, #144365);
+  background: #fff;
+  border: 2px solid var(--cassiopeia-color-link, #144365);
+  border-radius: .375rem;
+  cursor: pointer;
+}
+.calc-tab[aria-selected="true"] {
+  color: #fff;
+  background: var(--cassiopeia-color-link, #144365);
+}
+.calc-tab:focus-visible,
+.calc-toggle:focus-visible {
+  outline: 3px solid #f7cb2b;
+  outline-offset: 2px;
+}
+
+@media (max-width: 991.98px) {
+  .calc-layout { --calc-narrow: 1; }
+
+  .calc-layout.calc-js .calc-tabs {
+    display: flex;
+    gap: .5rem;
+    margin: .75rem 0 .5rem;
+    scroll-margin-top: 5rem;          /* kleepuva menüü all */
+  }
+  /* Ainult valitud vaheleht on nähtav (display:none tõstab ka fookusjärjekorrast välja) */
+  .calc-layout.calc-js[data-calc-pane="calc"] > .row > .calc-pane-data,
+  .calc-layout.calc-js[data-calc-pane="data"] > .row > .calc-pane-calc {
+    display: none;
+  }
+
+  /* Päisemooduli kaart on arvutivaates kleepuv (sticky-top); kitsas vaates võtaks see pool ekraani */
+  .calc-layout .card.position-sticky {
+    position: static !important;
+  }
+  .calc-layout .card-body {
+    padding: .75rem;
+  }
+
+  /* Hüpikmenüü-sarnased nupugrupid (aasta, sisendi liik, aluse valik) murduvad uuele reale */
+  .calc-pane-calc .btn-group.radio {
+    flex-wrap: wrap;
+    max-width: 100%;
+  }
+
+  /* Diagramm ja laiad tabelid (nt "Kahelapselise pere netosissetulek") ei tohi lehte laiendada */
+  .calc-pane-calc .chart {
+    max-width: 100%;
+    overflow-x: auto;
+  }
+  .calc-pane-calc .card-body table:not(.table-calc) {
+    display: block;
+    max-width: 100%;
+    overflow-x: auto;
+  }
+}
+
+/* Lähteandmete ja kärbete peitmise/näitamise nupud (loob calc-mobile.js kitsas vaates) */
+.calc-toggles {
+  display: flex;
+  flex-wrap: wrap;
+  gap: .5rem;
+  margin: .25rem 0 1rem;
+}
+.calc-toggle {
+  flex: 1 1 12rem;
+  position: relative;
+  padding-right: 2rem;
+  text-align: left;
+}
+.calc-toggle::after {
+  content: "\25BE";                   /* ▾ */
+  position: absolute;
+  right: .75rem;
+  top: 50%;
+  transform: translateY(-50%);
+}
+.calc-toggle[aria-expanded="true"]::after {
+  content: "\25B4";                   /* ▴ */
+}
+
+/* Tulemustabeli väikesed pealkirjad igas lahtris: nähtavad ainult telefoni laiusel (alla 576 px),
+   sest seal on iga rida kolmel real (nimetus, siis kaks väärtust kõrvuti) ja tulemustabeli
+   pealkirjarida on peidus. */
+.calc-cap { display: none; }
+
+@media (max-width: 575.98px) {
+  .calc-cap {
+    display: block;
+    font-size: .75rem;
+    line-height: 1.2;
+    font-weight: 400;
+    color: #6c757d;
+  }
+  .calc-head-row { display: none; }
+
+  /* Pealkirjad: päise h2 on HTML-is inline-stiiliga 1.55em, seepärast !important */
+  .calc-pane-calc h2 { font-size: 1.3rem !important; }
+  .calc-pane-calc h3 { font-size: 1.15rem; }
+  .calc-pane-calc h4 { font-size: 1.05rem; }
+  .calc-pane-calc .card-body h1 { font-size: 1.5rem; }
+
+  /* Aastanupud (btn-lg) väiksemaks, et mahuks kahele reale */
+  .calc-pane-calc #display-years .btn {
+    padding: .35rem .6rem;
+    font-size: 1rem;
+  }
+
+  /* Lähteandmed: kaks lahtrit reas (Fabrik annab col-sm-4, st telefonil üks lahter rea kohta) */
+  .calc-pane-data .fabrikGroup .row > .fabrikElementContainer.col-sm-4 {
+    width: 50%;
+  }
+  .calc-pane-data .fabrikGroup .row .fabrikElementReadOnly {
+    overflow-wrap: anywhere;          /* pikad sõned lähteandmete ruudustikus; tabelis mitte */
+  }
+  /* Kärbete tabelis ei tohi summa (nt 407822077.08) kahele reale murduda */
+  .calc-pane-data .repeatGroupTable [class*="___value_eur"] {
+    white-space: nowrap;
+  }
+}
