-        2
-      );
-  }
+  // senise korra ja kodanikupalga variandi tulumaks otsustatakse kumbki oma brutopalga järgi
+  // (varem nullis üks tingimus mõlemad, kui ainult ühe variandi palk jäi maksuvaba osast alla)
+  incometax.value = incomeTaxOn(grosswage.value, ui_employee.value, fpp_1.value, c);
+  if (i3 === true)
+    incometax_ubi.innerHTML = incomeTaxOn(grosswage_ubi.innerHTML, ui_employee_ubi.innerHTML, fpp_1_ubi.innerHTML, c);
   writeValues(incometax.id, incometax.value);
   if (i3 === true) writeValues(incometax_ubi.id, incometax_ubi.innerHTML);
 }
