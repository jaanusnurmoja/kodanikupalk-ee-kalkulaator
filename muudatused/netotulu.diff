+/*
+  Variant 1 (ühtekuuluvusmaks + senine tulumaks), "netotulu" režiim: brutopalk G, mille juures tööandjalt
+  kättesaadav osa (G miinus töötaja töötuskindlustus ja pension, tulumaks ning ühtekuuluvusmaks) on
+  täpselt sisestatud neto miinus kodanikupalk (N). Sama valem, mida kasutab calcIncomeTax / calcUbiTaxFields:
+    maksustatav = G * (1 - ins), ins = töötaja töötuskindlustus + pension
+    tulumaks    = r * (maksustatav - maksuvaba), kui maksustatav ületab maksuvaba, muidu 0
+    ühtekuuluvusmaks = a * G (alus on kogu brutopalk, nagu calcUbiTaxFields)
+  Tulumaksu hargnemine sõltub UBI-variandi enda brutopalgast (mitte sisestatud netost ega senise korra brutost),
+  seega on kaks lahendit; valitakse see, mille eeldus kehtib:
+    A) maksustatav <= maksuvaba (tulumaksu pole):  G = N / (1 - ins - a)
+    B) maksustatav > maksuvaba:  G = (N - r * maksuvaba) / ((1 - ins) * (1 - r) - a)
+  (Varem kasutati siin senise korra tulumaksu otsust, mis tehti kogu neto põhjal: vt MUUDATUSED-netotulu.md.)
+  Kontrollarvutus (vana kommentaar): kui neto on 1000 ja ubi 362, ühtekuuluvusmaks 28.32% ja tulumaks nagu on,
+  siis bruto peab olema 1079,897999820151 (parameetrid, mille all see leiti, pole teada).
+*/
+function grossUbiFromNetVariant1(c) {
+  var a = c.addedTax / 100;
+  var ins = c.fp1 + c.uip2;
+  var netFromEmployer = c.sum - c.ubiAdult;
+  var grossWithoutIncomeTax = netFromEmployer / (1 - ins - a);
+  if (grossWithoutIncomeTax * (1 - ins) <= c.taxfree) return grossWithoutIncomeTax;
+  var denominator = (1 - ins) * (1 - c.itr) - a;
+  if (!(denominator > 0)) return grossWithoutIncomeTax;
+  return (netFromEmployer - c.itr * c.taxfree) / denominator;
+}
